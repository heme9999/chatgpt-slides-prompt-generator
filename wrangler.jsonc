{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatgpt-slides-prompt-generator",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/events",
      "/chatgpt-slides-prompt-generator",
      "/chatgpt-slides-prompt-generator/"
    ]
  },
  "main": "src/worker.js",
  "d1_databases": [
    {
      "binding": "USAGE",
      "database_name": "slideprompt-usage",
      "database_id": "c7190553-6f8c-42b2-974d-ecf99191bce1"
    }
  ]
}
