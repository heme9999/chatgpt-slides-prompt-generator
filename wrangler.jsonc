{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatgpt-slides-prompt-generator",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
